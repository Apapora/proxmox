# Managed by Ansible. Edits will be overwritten.
# Home Assistant Container (not HAOS — no Supervisor / add-on store).
#
# network_mode: host is REQUIRED here, not optional:
#   - mDNS / SSDP discovery of LAN devices needs raw L2 access.
#   - HA must reach the Crestron CP2E processor on the LAN (XSIG/EISC or MQTT)
#     to drive AV / lights / shades.
# Consequence: HA binds {{ homeassistant_port }} on the LXC IP directly;
# no port mapping. Reach it at http://10.0.0.164:{{ homeassistant_port }}.

services:
  homeassistant:
    image: {{ homeassistant_image }}
    container_name: homeassistant
    restart: unless-stopped
    network_mode: host
    privileged: false
    environment:
      TZ: "{{ homeassistant_tz }}"
    volumes:
      - {{ homeassistant_config_dir }}:/config
      # Lets HA read host timezone; harmless, recommended by HA docs.
      - /etc/localtime:/etc/localtime:ro

