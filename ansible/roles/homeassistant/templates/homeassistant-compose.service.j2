# Brings the Home Assistant compose stack up on boot.
# Same rationale as the torrents unit: travel-mode-on runs `docker compose down`
# which REMOVES containers — a restart policy can't resurrect what no longer
# exists. This oneshot recreates them at boot. Idempotent: if already running,
# `up -d` is a no-op.
[Unit]
Description=Home Assistant docker compose stack
Requires=docker.service
After=docker.service

[Service]
Type=oneshot
RemainAfterExit=true
WorkingDirectory={{ homeassistant_stack_dir }}
ExecStart=/usr/bin/docker compose up -d
ExecStop=/usr/bin/docker compose down

[Install]
WantedBy=multi-user.target
