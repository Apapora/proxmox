# Hermes secrets — loaded by the container via compose `env_file: .env`.
# Mode 0600, never committed. Inject real values via direnv on the workstation
# (same pattern as the torrents role's Nord creds).
#
# Brain model key — future DeepSeek brain. config.yaml will reference it as
# ${DEEPSEEK_API_KEY}. Empty for now; you set it when you wire DeepSeek up.
{% if hermes_deepseek_api_key | default('') | length > 0 %}
DEEPSEEK_API_KEY={{ hermes_deepseek_api_key }}
{% else %}
# DEEPSEEK_API_KEY=   (not set yet)
{% endif %}

# Discord control plane (gateway WebSocket — outbound, no inbound ports).
# Tokens from .envrc via direnv. DISCORD_ALLOWED_USERS is mandatory: without it
# the gateway denies every message as a safety default.
{% if hermes_discord_bot_token | default('') | length > 0 %}
DISCORD_BOT_TOKEN={{ hermes_discord_bot_token }}
DISCORD_ALLOWED_USERS={{ hermes_discord_allowed_users }}
{% else %}
# DISCORD_BOT_TOKEN / DISCORD_ALLOWED_USERS   (not set yet)
{% endif %}
