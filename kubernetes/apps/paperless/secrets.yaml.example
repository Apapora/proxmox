# Copy to secrets.yaml (gitignored) and fill in. secrets.yaml is NOT committed.
#   cp secrets.yaml.example secrets.yaml  &&  edit values
# Generate strong values:
#   openssl rand -base64 36   (postgres-password, paperless-secret-key)
apiVersion: v1
kind: Secret
metadata:
  name: paperless-secret
  namespace: paperless
type: Opaque
stringData:
  postgres-password: REPLACE_ME_WITH_STRONG_PASSWORD
  paperless-secret-key: REPLACE_ME_WITH_LONG_RANDOM_STRING
  admin-password: REPLACE_ME_WITH_ADMIN_LOGIN_PASSWORD
